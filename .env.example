# DocumentForge environment template
#
# Copy to `.env` (`cp .env.example .env`), fill in real values, then:
#   docker compose up -d
#
# Anything left unset uses the Dockerfile defaults.

# ─── Engine secrets ──────────────────────────────────────────────────
# API key required on every request. REQUIRED: the engine refuses to
# start with no key configured (it binds all interfaces inside the
# container, and unauthenticated + non-loopback is never allowed).
# Generate with: openssl rand -hex 24
DFDB_API_KEY=

# Shared secret for replication between leader and follower nodes.
# Only set if you'll add followers. Generate with: openssl rand -hex 32
DFDB_REPLICATION_SECRET=

# Friendly node name in cluster topology + logs.
DFDB_NODE_NAME=dfdb-1

# ─── Admin UI (build-time) ───────────────────────────────────────────
# URL the browser will use to reach the engine. Baked into the Next.js
# bundle at build time, so changing this requires rebuilding admin-ui.
#   Local dev / single-host:  http://localhost:5000  (default)
#   Public deploy:            https://dfdb.example.com
NEXT_PUBLIC_DFDB_URL=http://localhost:5000
