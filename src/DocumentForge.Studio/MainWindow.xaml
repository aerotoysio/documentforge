<Window x:Class="DocumentForge.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="https://github.com/Dirkster99/AvalonDock"
        xmlns:adcontrols="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
        xmlns:vm="clr-namespace:DocumentForge.Studio.ViewModels"
        xmlns:views="clr-namespace:DocumentForge.Studio.Views"
        Title="DocumentForge Studio"
        Height="760" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshAllCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- Object Explorer node templates -->
        <HierarchicalDataTemplate DataType="{x:Type vm:ServerNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="New Query" Command="{Binding NewQueryCommand}"/>
                        <MenuItem Header="Refresh" Command="{Binding RefreshCommand}"/>
                        <Separator/>
                        <MenuItem Header="Disconnect" Command="{Binding DisconnectCommand}"/>
                    </ContextMenu>
                </StackPanel.ContextMenu>
                <TextBlock Text="{Binding Glyph}" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type vm:DatabaseNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="New Query" Command="{Binding NewQueryCommand}"/>
                        <MenuItem Header="Refresh" Command="{Binding RefreshCommand}"/>
                        <MenuItem Header="Properties…" Command="{Binding PropertiesCommand}"/>
                        <Separator Visibility="{Binding CanDrop, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="Detach / Drop…" Command="{Binding DropCommand}"
                                  Visibility="{Binding CanDrop, Converter={StaticResource BoolToVis}}"/>
                    </ContextMenu>
                </StackPanel.ContextMenu>
                <TextBlock Text="{Binding Glyph}" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Name}"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type vm:CollectionNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open (SELECT * … LIMIT 100)" Command="{Binding OpenCollectionCommand}"/>
                        <MenuItem Header="New Query" Command="{Binding NewQueryCommand}"/>
                        <Separator/>
                        <MenuItem Header="Insert Document…" Command="{Binding InsertDocumentCommand}"/>
                        <MenuItem Header="New Index…" Command="{Binding NewIndexCommand}"/>
                        <MenuItem Header="Refresh" Command="{Binding RefreshCommand}"/>
                    </ContextMenu>
                </StackPanel.ContextMenu>
                <TextBlock Text="{Binding Glyph}" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Name}"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type vm:FolderNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Glyph}" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Name}" Foreground="#666"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type vm:IndexNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Drop Index…" Command="{Binding DropCommand}"/>
                    </ContextMenu>
                </StackPanel.ContextMenu>
                <TextBlock Text="{Binding Glyph}" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Name}"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type vm:LoadingNodeViewModel}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" Foreground="Gray" FontStyle="Italic"/>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type vm:MessageNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Glyph}" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Name}" Foreground="DarkRed" TextWrapping="Wrap" MaxWidth="240"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- Document (tab) content templates -->
        <DataTemplate DataType="{x:Type vm:QueryDocumentViewModel}">
            <views:QueryDocumentView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:WelcomeDocumentViewModel}">
            <ScrollViewer>
                <StackPanel Margin="40" MaxWidth="620" HorizontalAlignment="Left">
                    <TextBlock Text="DocumentForge Studio" FontSize="28" FontWeight="Light"/>
                    <TextBlock Text="SSMS-style management for DocumentForge"
                               FontSize="14" Foreground="Gray" Margin="0,4,0,24"/>
                    <TextBlock FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12">
                        Connect to a local .dfdb file, a local DocumentForge service, or a remote
                        endpoint using the Object Explorer on the left. Right-click a server, database,
                        or collection and choose <Run FontWeight="SemiBold"/><Run Text="New Query"/> to open a
                        SQL workbench. Press <Run FontWeight="SemiBold" Text="F5"/> in the editor to execute.
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="🔌  Connect Object Explorer…" Command="{Binding DataContext.ConnectCommand,
                                RelativeSource={RelativeSource AncestorType=Window}}" Padding="12,6" Margin="0,0,12,0"/>
                        <Button Content="🗄  New Database…" Command="{Binding DataContext.NewDatabaseCommand,
                                RelativeSource={RelativeSource AncestorType=Window}}" Padding="12,6"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Connect Object Explorer…" Command="{Binding ConnectCommand}"/>
                <MenuItem Header="_New Database…" Command="{Binding NewDatabaseCommand}"/>
                <Separator/>
                <MenuItem Header="_Export Settings…" Command="{Binding ExportSettingsCommand}"/>
                <MenuItem Header="_Import Settings…" Command="{Binding ImportSettingsCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Refresh All" Command="{Binding RefreshAllCommand}" InputGestureText="F5"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About DocumentForge Studio" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Command="{Binding ConnectCommand}" ToolTip="Connect Object Explorer">🔌 Connect</Button>
                <Button Command="{Binding NewDatabaseCommand}" ToolTip="New Database">🗄 New Database</Button>
                <Separator/>
                <Button Command="{Binding RefreshAllCommand}" ToolTip="Refresh All (F5)">🔄 Refresh</Button>
            </ToolBar>
        </ToolBarTray>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding VersionText}" Foreground="Gray"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Docking area: Object Explorer (left) + document tabs (right) -->
        <ad:DockingManager x:Name="DockManager"
                           DocumentsSource="{Binding Documents}"
                           ActiveContent="{Binding ActiveDocument, Mode=TwoWay}"
                           DocumentClosed="OnDocumentClosed">
            <ad:DockingManager.LayoutItemContainerStyle>
                <Style TargetType="{x:Type adcontrols:LayoutItem}">
                    <Setter Property="Title" Value="{Binding Model.Title}"/>
                    <Setter Property="ContentId" Value="{Binding Model.ContentId}"/>
                    <Setter Property="CanClose" Value="{Binding Model.CanClose}"/>
                    <Setter Property="IsSelected" Value="{Binding Model.IsSelected, Mode=TwoWay}"/>
                    <Setter Property="IsActive" Value="{Binding Model.IsActive, Mode=TwoWay}"/>
                </Style>
            </ad:DockingManager.LayoutItemContainerStyle>
            <ad:LayoutRoot>
                <ad:LayoutPanel Orientation="Horizontal">
                    <ad:LayoutAnchorablePane DockWidth="320">
                        <ad:LayoutAnchorable Title="Object Explorer" CanClose="False" CanHide="False"
                                             ContentId="objectExplorer">
                            <TreeView ItemsSource="{Binding Servers}" BorderThickness="0">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                        </ad:LayoutAnchorable>
                    </ad:LayoutAnchorablePane>
                    <ad:LayoutDocumentPane/>
                </ad:LayoutPanel>
            </ad:LayoutRoot>
        </ad:DockingManager>
    </DockPanel>
</Window>
