<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>DocumentForgeStudio</AssemblyName>
    <RootNamespace>DocumentForge.Studio</RootNamespace>
    <ApplicationIcon>Assets\studio.ico</ApplicationIcon>

    <!-- Studio has its own version, independent of the engine's (Directory.Build.props). -->
    <Version>0.12.0</Version>
    <AssemblyVersion>0.12.0.0</AssemblyVersion>
    <FileVersion>0.12.0.0</FileVersion>
    <InformationalVersion>0.12.0-beta</InformationalVersion>
    <Product>DocumentForge Studio</Product>
    <Description>SSMS-style management studio for DocumentForge — connect, query, edit, and manage databases, replication, and sharding.</Description>
    <Company>DocumentForge</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="AvalonEdit" Version="6.*" />
    <PackageReference Include="Dirkster.AvalonDock" Version="4.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocumentForge.Studio.Core\DocumentForge.Studio.Core.csproj" />
  </ItemGroup>

</Project>
