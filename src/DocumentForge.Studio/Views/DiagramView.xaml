<UserControl x:Class="DocumentForge.Studio.Views.DiagramView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DocumentForge.Studio.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DiagramDocumentViewModel}">
    <DockPanel>
        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar>
                <Button Content="🔄 Refresh" Command="{Binding RefreshCommand}" Padding="8,2"/>
                <Button Content="➕ Add relationship" Command="{Binding AddRelationshipCommand}" Padding="8,2"/>
                <Button Content="▦ Auto layout" Command="{Binding AutoLayoutCommand}" Padding="8,2"/>
                <Separator/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="4,0"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Legend -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10,6">
            <TextBlock Text="∞→1 relationship reads child → parent." Foreground="Gray" FontSize="11" Margin="0,0,16,0"/>
            <TextBlock Text="⊘ restrict" FontSize="11" Margin="0,0,12,0"/>
            <TextBlock Text="∅ set null" FontSize="11" Margin="0,0,12,0"/>
            <TextBlock Text="⇒ cascade" FontSize="11" Margin="0,0,12,0"/>
            <TextBlock Text="⚠ unindexed ref field (checks will scan)" FontSize="11" Foreground="#B25A00"/>
        </StackPanel>

        <!-- Diagram surface -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FAFBFC">
            <Grid Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}">

                <!-- Connector lines (behind boxes). A fat transparent twin line
                     makes the thin visible one comfortably clickable. -->
                <ItemsControl ItemsSource="{Binding Edges}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Canvas>
                                <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                      Stroke="Transparent" StrokeThickness="12" Cursor="Hand"
                                      ToolTip="{Binding Tooltip}">
                                    <Line.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.EditRelationshipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Line.InputBindings>
                                </Line>
                                <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                      Stroke="#5A7AA8" StrokeThickness="2" IsHitTestVisible="False"/>
                                <!-- Parent-end "1" dot -->
                                <Ellipse Width="8" Height="8" Fill="#5A7AA8" IsHitTestVisible="False"
                                         Margin="-4,-4,0,0"
                                         Canvas.Left="{Binding X2}" Canvas.Top="{Binding Y2}"/>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Connector badges -->
                <ItemsControl ItemsSource="{Binding Edges}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding BadgeX}"/>
                            <Setter Property="Canvas.Top" Value="{Binding BadgeY}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#5A7AA8" BorderThickness="1"
                                    CornerRadius="9" Padding="6,1" Cursor="Hand" ToolTip="{Binding Tooltip}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.EditRelationshipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="#33507A"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Collection boxes -->
                <ItemsControl ItemsSource="{Binding Nodes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="{Binding Width}" Height="{Binding Height}"
                                    Background="White" CornerRadius="6"
                                    MouseLeftButtonDown="Node_MouseLeftButtonDown"
                                    MouseMove="Node_MouseMove"
                                    MouseLeftButtonUp="Node_MouseLeftButtonUp"
                                    Cursor="SizeAll">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#2A5DB0"/>
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGhost}" Value="True">
                                                <Setter Property="BorderBrush" Value="#B0641E"/>
                                                <Setter Property="Opacity" Value="0.75"/>
                                                <Setter Property="ToolTip"
                                                        Value="Referenced collection — no documents or schema of its own yet."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.18"/>
                                </Border.Effect>
                                <DockPanel>
                                    <!-- Header -->
                                    <Border DockPanel.Dock="Top" Background="#E8F0FE" CornerRadius="5,5,0,0"
                                            Height="30" Padding="8,0">
                                        <DockPanel VerticalAlignment="Center">
                                            <TextBlock DockPanel.Dock="Right" Text="🛡" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       ToolTip="This collection has a schema (validated on every write)."
                                                       Visibility="{Binding HasSchema, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding CollectionName}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                    <!-- Fields -->
                                    <ItemsControl ItemsSource="{Binding Fields}" Margin="8,2,8,2"
                                                  IsHitTestVisible="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Height="18">
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontSize="10"
                                                               Width="16" VerticalAlignment="Center"/>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="10"
                                                               Foreground="#888" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="11"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
