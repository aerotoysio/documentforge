<UserControl x:Class="DocumentForge.Studio.Views.SqlReferenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DocumentForge.Studio.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SqlReferenceDocumentViewModel}">
    <DockPanel>
        <!-- Search -->
        <DockPanel DockPanel.Dock="Top" Margin="10,8">
            <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Padding="4,3"
                     ToolTip="Filter the DocumentForge SQL reference"/>
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Foreground="Gray" FontSize="11" Margin="10,4"
                   Text="Insert drops the example into your most recent query tab; Copy puts it on the clipboard."/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Entries}" Margin="10,0,10,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#E4E4E4" BorderThickness="1" CornerRadius="5"
                                Padding="12,8" Margin="0,0,0,8" Background="White">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="#EEF3FF" CornerRadius="3" Padding="6,1">
                                        <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#2A5DB0"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                                </DockPanel>

                                <TextBlock Text="{Binding Syntax}" FontFamily="Consolas" FontSize="12"
                                           Foreground="#444" TextWrapping="Wrap" Margin="0,6,0,0"/>

                                <Border Background="#F7F8FA" CornerRadius="3" Padding="8,5" Margin="0,6,0,0">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="Insert" Padding="8,1" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.InsertCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Copy" Padding="8,1" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.CopyCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Example}" FontFamily="Consolas" FontSize="12"
                                                   Foreground="#1A1A1A" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </Border>

                                <TextBlock Text="{Binding Notes}" Foreground="Gray" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,5,0,0"
                                           Visibility="{Binding Notes, Converter={StaticResource NonEmptyToVis}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
