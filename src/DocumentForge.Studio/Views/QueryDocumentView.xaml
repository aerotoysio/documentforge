<UserControl x:Class="DocumentForge.Studio.Views.QueryDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:vm="clr-namespace:DocumentForge.Studio.ViewModels"
             d:DataContext="{d:DesignInstance vm:QueryDocumentViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" MinHeight="80"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*" MinHeight="80"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBarTray Grid.Row="0" IsLocked="True">
            <ToolBar>
                <Button x:Name="RunButton" Click="OnRun" Padding="8,2"
                        ToolTip="Execute (F5). Runs the selected text if any, otherwise the whole editor.">▶ Run</Button>
                <Button Command="{Binding CancelCommand}" ToolTip="Cancel" Padding="8,2">■ Cancel</Button>
                <Separator/>
                <TextBlock Text="Database:" VerticalAlignment="Center" Margin="4,0,4,0"/>
                <TextBlock Text="{Binding Database}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <Separator/>
                <CheckBox Content="Limit rows" IsChecked="{Binding LimitRows}" VerticalAlignment="Center"/>
                <TextBox Text="{Binding RowLimit}" Width="56" Margin="4,0,0,0" VerticalAlignment="Center"
                         ToolTip="Auto-append LIMIT to unbounded SELECTs"/>
                <Separator/>
                <CheckBox x:Name="ShowSystemFields" Content="System fields" IsChecked="False"
                          VerticalAlignment="Center" Click="OnShowSystemFieldsToggled"
                          ToolTip="Show the engine's _id / _etag columns (storage identity and concurrency token — not document data)"/>
                <Separator/>
                <TextBlock Text="Timeout (s):" VerticalAlignment="Center" Margin="4,0,4,0"/>
                <TextBox Text="{Binding TimeoutSeconds}" Width="44" VerticalAlignment="Center"
                         ToolTip="Auto-cancel the query after N seconds (0 = no timeout)"/>
                <Separator/>
                <TextBlock Text="History:" VerticalAlignment="Center" Margin="4,0,4,0"/>
                <ComboBox x:Name="HistoryCombo" Width="240" ItemsSource="{Binding History}"
                          SelectionChanged="OnHistorySelected" ToolTip="Re-run a previous query"/>
                <Separator/>
                <Button Content="❔ SQL Help" Padding="8,2"
                        Command="{Binding DataContext.OpenSqlReferenceCommand,
                            RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="Open the DocumentForge SQL reference"/>
            </ToolBar>
        </ToolBarTray>

        <!-- SQL editor -->
        <avalonedit:TextEditor x:Name="Editor" Grid.Row="1"
                               ShowLineNumbers="True"
                               FontFamily="Consolas" FontSize="13"
                               WordWrap="False"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"
                               BorderBrush="#DDD" BorderThickness="0,1,0,0"/>

        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch"
                      Background="#EEE" ResizeBehavior="PreviousAndNext"/>

        <!-- Results -->
        <DockPanel Grid.Row="3">
            <ProgressBar DockPanel.Dock="Top" Height="3" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            <StatusBar DockPanel.Dock="Bottom">
                <StatusBarItem><TextBlock Text="{Binding StatusSummary}"/></StatusBarItem>
            </StatusBar>
            <TabControl SelectedIndex="{Binding SelectedResultTab}">
                <TabItem Header="Results">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#FFFDE7" Padding="8,4"
                                BorderBrush="#F0E0A0" BorderThickness="0,0,0,1"
                                Visibility="{Binding IsGridEditable, Converter={StaticResource BoolToVis}}">
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#665500">
                                ✎ Editing enabled — edit a cell and press Enter to save (ETag-guarded);
                                right-click a row to delete. <Run FontStyle="Italic" Text="_id and _etag are read-only."/>
                            </TextBlock>
                        </Border>
                        <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding ResultView}"
                                  IsReadOnly="{Binding IsGridReadOnly}" AutoGenerateColumns="True"
                                  AutoGeneratingColumn="OnAutoGeneratingColumn"
                                  CellEditEnding="OnCellEditEnding"
                                  CanUserSortColumns="True" CanUserResizeColumns="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionMode="Extended" SelectionUnit="CellOrRowHeader"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  HeadersVisibility="All" GridLinesVisibility="All"
                                  FontFamily="Consolas" FontSize="12">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Delete Row…" Click="OnDeleteRow"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="JSON">
                    <TextBox Text="{Binding JsonText, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" BorderThickness="0"/>
                </TabItem>
                <TabItem Header="Messages">
                    <TextBox Text="{Binding Messages, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="Wrap" BorderThickness="0"/>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</UserControl>
