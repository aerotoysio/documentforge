<Window x:Class="DocumentForge.Studio.Views.RelationshipDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relationship"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            <RowDefinition/><RowDefinition/><RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,12"
                   Text="A relationship makes the child field point at an existing document in the parent collection. The engine enforces it on every write, and on parent deletes per the rule below."/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Child collection:" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="ChildCollectionBox" IsEditable="True" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Child field:" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="ChildFieldBox" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Parent collection:" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <ComboBox  Grid.Row="3" Grid.Column="1" x:Name="ParentCollectionBox" IsEditable="True" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Parent field:" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TargetFieldBox" Text="_id" Margin="0,0,0,8"
                   ToolTip="_id (the primary key) or a business key — put a unique index on business keys."/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="On parent delete:" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <ComboBox  Grid.Row="5" Grid.Column="1" x:Name="OnDeleteBox" Margin="0,0,0,8">
            <ComboBoxItem Tag="restrict"  IsSelected="True">Restrict — refuse the delete while children reference it</ComboBoxItem>
            <ComboBoxItem Tag="setNull">Set null — blank the child field, keep the child</ComboBoxItem>
            <ComboBoxItem Tag="cascade">Cascade — delete referencing children too (recursive)</ComboBoxItem>
        </ComboBox>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="RemoveButton" Content="Remove relationship" Click="Remove_Click"
                    Padding="10,4" Margin="0,0,10,0" Visibility="Collapsed"
                    Foreground="#A33" ToolTip="Delete this relationship from the child collection's schema."/>
            <Button Content="Save" Click="Save_Click" IsDefault="True" Padding="18,4" Margin="0,0,10,0"/>
            <Button Content="Cancel" IsCancel="True" Padding="12,4"/>
        </StackPanel>
    </Grid>
</Window>
