<Window x:Class="DocumentForge.Studio.Views.AttachDatabaseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Attach Database File"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="File:" VerticalAlignment="Center" Width="90"/>
            <Button DockPanel.Dock="Right" Content="Browse…" Width="80" Margin="8,0,0,0" Click="OnBrowse"/>
            <TextBox x:Name="PathBox" VerticalContentAlignment="Center"/>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Attach as:" VerticalAlignment="Center" Width="90"/>
            <TextBox x:Name="NameBox" VerticalContentAlignment="Center"/>
        </DockPanel>

        <TextBlock Grid.Row="2" Foreground="Gray" FontSize="11" Margin="90,0,0,4" TextWrapping="Wrap"
                   Text="Sidecar files next to the database (.wal write-ahead log, .recovery) are picked up and replayed automatically when the server opens the file — keep them together."/>
        <TextBlock Grid.Row="3" x:Name="HintText" Foreground="Gray" FontSize="11"
                   Margin="90,0,0,12" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Attach" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OnAttach"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
