<Window x:Class="DocumentForge.Studio.Views.InsertDocumentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Insert Document"
        Width="560" Height="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Collection:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock x:Name="CollectionText" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Format" Width="80" Margin="0,0,8,0" Click="OnFormat"/>
            <Button Content="Insert" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OnInsert"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Foreground="DarkRed"
                   TextWrapping="Wrap" Margin="0,8,0,0"/>

        <TextBox x:Name="JsonBox"
                 FontFamily="Consolas" FontSize="13"
                 AcceptsReturn="True" AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"/>
    </DockPanel>
</Window>
