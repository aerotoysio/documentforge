<Window x:Class="DocumentForge.Studio.Views.NewDatabaseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Database"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Create on:" VerticalAlignment="Center" Width="90"/>
            <ComboBox x:Name="TargetCombo"/>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Name:" VerticalAlignment="Center" Width="90"/>
            <TextBox x:Name="NameBox"/>
        </DockPanel>

        <TextBlock Grid.Row="2" x:Name="HintText" Foreground="Gray" FontSize="11"
                   Margin="90,0,0,12" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Create" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OnCreate"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
