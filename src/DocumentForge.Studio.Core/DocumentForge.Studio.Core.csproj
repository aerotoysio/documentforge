<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UI-free logic for DocumentForge Studio: connection abstraction (direct
    file vs HTTP), settings/connection stores, DPAPI secret store, and the
    plain-text export/import bundle. Windows-only because secrets use DPAPI.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocumentForge.Engine\DocumentForge.Engine.csproj" />
  </ItemGroup>

</Project>
